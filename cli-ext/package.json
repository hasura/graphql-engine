{
  "name": "scaffolder",
  "version": "1.0.0",
  "description": "A service to generate Hasura action scaffolds",
  "main": "src/server.js",
  "scripts": {
    "transpile": "rm -rf build/* && babel --extensions '.ts,.js' ./src ./tests --out-dir build",
    "prebuild": "npm run transpile",
    "build": "./build.sh",
    "pretest": "npm run transpile && babel ./tests --out-dir _tmptests",
    "posttest": "rm -rf _tmptests",
    "test": "node ./_tmptests/index.js",
    "test:unit": "vitest",
    "lint": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "npx prettier --write \"**/*.+(js|jsx|css|json|md|mdx)\""
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix",
      "npx prettier --write \"**/*.+(js|jsx|css|json|md|mdx)\"",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@graphql-codegen/core": "^1.9.0",
    "@graphql-codegen/typescript": "^1.9.0",
    "graphql": "15.10.2",
    "inflection": "3.0.2"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "immutable": "^4.3.9"
  },
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-async-to-generator": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@yao-pkg/pkg": "6.21.0",
    "eslint": "^10.8.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
